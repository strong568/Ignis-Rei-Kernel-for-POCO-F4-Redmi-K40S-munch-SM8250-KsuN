# KernelSU-Next Root Support (Syscall Table Hook for 4.19 Non-GKI)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_SYSCALL_TABLE_HOOK is not set
# CONFIG_KSU_KPROBES_HOOK is not set
# CONFIG_KPROBES is not set
# CONFIG_KPROBE_EVENTS is not set

# Platform
CONFIG_MACH_XIAOMI_MUNCH=y

# Touchscreen
CONFIG_TOUCHSCREEN_FOCALTECH_3658U=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_SUPPORT_NEW_GAME_MODE=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC=y
CONFIG_FINGERPRINT_GOODIX=y

# Power
CONFIG_QPNP_SMB5=n
CONFIG_QPNP_SMB5_MUNCH=y
CONFIG_BQ2597X_CHARGE_PUMP_STANDALONE_MUNCH=y
CONFIG_CHARGER_LN8000_MUNCH=y
CONFIG_FUEL_GAUGE_BQ27Z561_MUNCH=y

# Ultrasound Proximity
CONFIG_US_PROXIMITY=y

# Vibrator
CONFIG_INPUT_AW86927_HAPTIC=y

# Camera
CONFIG_TECHPACK_CAMERA_XIAOMI=y

# LOCALVERSION
CONFIG_LOCALVERSION="-REI-PERF"
# CONFIG_LOCALVERSION_AUTO is not set

# Performance & Display Frame Alignment (300Hz timer for 60/120Hz displays)
CONFIG_HZ_300=y
# CONFIG_HZ_250 is not set
CONFIG_HZ=300

# Cmdline & PSI
CONFIG_CMDLINE="rcu_nocbs=0-7"
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n

# Stability & Clang Boot Fixes (Match working RE404 reference)
CONFIG_INIT_STACK_NONE=y
# CONFIG_INIT_STACK_ALL_ZERO is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_VMAP_STACK is not set
# CONFIG_ARM64_SW_TTBR0_PAN is not set
# CONFIG_ARM64_PAN is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_STACKPROTECTOR_STRONG is not set
# CONFIG_RANDOMIZE_MODULE_REGION_FULL is not set
CONFIG_PANIC_TIMEOUT=5
# CONFIG_QCOM_FORCE_WDOG_BITE_ON_PANIC is not set

# Disable Clang CFI and Shadow Call Stack (prevents forward-edge trap reboots with Clang)
# CONFIG_CFI is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI_PERMISSIVE is not set
# CONFIG_SHADOW_CALL_STACK is not set

# Disable experimental BPF LSM
# CONFIG_BPF_LSM is not set

# Android 14+ / 17 cgroup & process accounting
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y

# Modern Filesystem & Storage features (Android 14-17 F2FS compression & Ext4 encryption)
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_EXT4_ENCRYPTION=y
CONFIG_FS_ENCRYPTION=y

# First Stage Init requirements
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y

# Android 15/16/17 Security & SELinux
CONFIG_SECURITYFS=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_SECURITY_NETWORK=y
CONFIG_DEFAULT_SECURITY_SELINUX=y

# Module Compatibility (Load custom ROM / stock vendor modules safely)
CONFIG_MODULE_FORCE_LOAD=y
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_ALL is not set

# Tethering & Netfilter options for Android 15/16/17
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_IP6_NF_NAT=y

# Optimization and Size Reduction (Disable bloated debug & header embeds)
# CONFIG_IKHEADERS is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_ALIGN_RODATA is not set
# CONFIG_RELR is not set
# CONFIG_ARCH_HAS_RELR is not set

# OPlus / ColorOS / OxygenOS Universal Port Support (Ki-kernel style)
CONFIG_E404_ATTRIBUTES=y
CONFIG_E404_OPLUS=y
CONFIG_OPLUS_PORT=y
CONFIG_OPLUS_OPROJECT=y
CONFIG_OPLUS_NANDSWAP=y
CONFIG_OPLUS_NWPOWER=y
CONFIG_OPLUS_STUB_NODES=y
CONFIG_OPLUS_HANS=y
